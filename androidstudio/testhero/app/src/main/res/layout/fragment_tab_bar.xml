<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAF4EE">

    <!-- ✅ 상단 툴바 이미지 로고 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="#FAF4EE"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="256dp"
            android:layout_height="210dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="0dp"
            android:adjustViewBounds="true"
            android:contentDescription="Re:mind 로고"
            android:scaleType="fitStart"
            android:src="@drawable/remind_logo" />
    </LinearLayout>

    <!-- ✅ 4분면 버튼 배치 -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnCount="2"
        android:rowCount="2"
        android:padding="16dp"
        android:useDefaultMargins="true"
        android:alignmentMode="alignMargins">

        <!-- 🔹 개인정보 열람 -->
        <LinearLayout
            android:id="@+id/btnPersonal"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="0"
            android:layout_column="0"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/rounded_shadow_bg"
            android:elevation="6dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/image_personal_info"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/privacy"
                android:contentDescription="개인정보 열람"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="개인정보 열람"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#000"
                android:gravity="center"/>
        </LinearLayout>

        <!-- 🔹 집 위치 저장 및 길찾기 -->
        <LinearLayout
            android:id="@+id/btnGps"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="0"
            android:layout_column="1"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/rounded_shadow_bg"
            android:elevation="6dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/image_gps"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/map"
                android:contentDescription="집 위치 저장 및 길찾기"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="집 위치 저장 및 길찾기"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#000"
                android:gravity="center"/>
        </LinearLayout>

        <!-- 🔹 약 복용 관리 -->
        <LinearLayout
            android:id="@+id/btnMedicine"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="1"
            android:layout_column="0"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/rounded_shadow_bg"
            android:elevation="6dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/image_medication"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/pill"
                android:contentDescription="약, 식사 복용 관리"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="약, 식사 복용 관리"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#000"
                android:gravity="center"/>
        </LinearLayout>

        <!-- 🔹 위급 상황 -->
        <LinearLayout
            android:id="@+id/btnEmergency"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="1"
            android:layout_column="1"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/rounded_shadow_bg"
            android:elevation="6dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/image_emergency"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/emergencycall"
                android:contentDescription="위급 상황"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="⚠️ 위급 상황"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#000"
                android:gravity="center"/>
        </LinearLayout>
    </GridLayout>

</LinearLayout>